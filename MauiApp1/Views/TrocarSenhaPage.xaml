<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.TrocarSenhaPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout Padding="30"
                         Spacing="18"
                         VerticalOptions="Center">

        <Label Text="Troca de senha"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center" />

        <Label Text="Por segurança, defina uma nova senha antes de continuar."
               HorizontalTextAlignment="Center" />

        <Frame Padding="20">
            <VerticalStackLayout Spacing="12">

                <Label Text="Nova senha:" />
                <Entry x:Name="entry_nova_senha"
                       Placeholder="Mínimo de 6 caracteres"
                       IsPassword="True" />

                <Label Text="Confirmar nova senha:" />
                <Entry x:Name="entry_confirmar_senha"
                       Placeholder="Repita a nova senha"
                       IsPassword="True" />

                <Button Text="Salvar e entrar"
                        Clicked="Button_Salvar_Clicked" />

            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>

</ContentPage>
