<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.SincronizacaoBackup"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid>

        <Image Source="amarv_logo.png"
               Opacity="0.06"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <ScrollView>

            <VerticalStackLayout Padding="20"
                                 Spacing="15"
                                 VerticalOptions="Center">

                <Label Text="Sincronização e Backup"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="lbl_relogio"
                       Text="00/00/0000 00:00:00"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalTextAlignment="Center" />

                <Frame Padding="15"
                       BackgroundColor="White"
                       BorderColor="#DDDDDD">

                    <VerticalStackLayout Spacing="12">

                        <!-- ================================= -->
                        <!-- CONFIGURAÇÃO DO SERVIDOR -->
                        <!-- ================================= -->

                        <Label Text="Configuração do servidor"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />

                        <Label Text="Digite o IP do servidor:"
                               FontSize="16"
                               TextColor="Black" />

                        <Entry x:Name="txt_IpServidor"
                               Placeholder="Ex.:192.168.56.1"
                               Text="192.168.56.1"
                               Keyboard="Telephone"
                               FontSize="18"
                               TextColor="Black"
                               BackgroundColor="#F5F5F5"
                               ClearButtonVisibility="WhileEditing" />

                        <Label Text="Token do servidor (config.local.php):"
                               FontSize="16"
                               TextColor="Black" />

                        <Entry x:Name="txt_TokenServidor"
                               Placeholder="Cole aqui o API_TOKEN"
                               IsPassword="True"
                               FontSize="18"
                               TextColor="Black"
                               BackgroundColor="#F5F5F5" />

                        <Button Text="💾 Salvar IP do Servidor"
                                Clicked="Button_SalvarIp_Clicked" />

                        <!-- ================================= -->
                        <!-- STATUS -->
                        <!-- ================================= -->

                        <Label x:Name="lbl_status"
                               Text="Status: aguardando ação."
                               FontSize="16"
                               TextColor="Black" />

                        <!-- ================================= -->
                        <!-- SINCRONIZAÇÃO -->
                        <!-- ================================= -->

                        <Label Text="Sincronização de dados"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />

                        <!-- Enviar somente -->
                        <Button Text="📤 Enviar dados para o servidor"
                                Clicked="Button_Enviar_Clicked" />

                        <!-- Recuperar somente -->
                        <Button Text="📥 Recuperar dados do servidor"
                                Clicked="Button_Recuperar_Clicked" />

                        <!-- ================================= -->
                        <!-- BACKUP -->
                        <!-- ================================= -->


                        <Label x:Name="lbl_titulo_backup"
       Text="Backup e restauração"
       FontSize="20"
       FontAttributes="Bold"
       TextColor="{StaticResource Primary}" />
                        
                        <Button x:Name="btn_backup_servidor"
        Text="💾 Realizar Backup no Servidor"
        Clicked="Button_Backup_Clicked" />

                        <Button x:Name="btn_enviar_banco"
        Text="🗄 Enviar Banco de Dados (.db3) ao Servidor"
        Clicked="Button_EnviarBanco_Clicked" />

                        <Button x:Name="btn_restaurar_backup"
        Text="📂 Escolher Backup para Restaurar"
        Clicked="Button_AbrirBackup_Clicked" />


                        <!-- ================================= -->
                        <!-- MENU -->
                        <!-- ================================= -->

                        <Button Text="Voltar ao Menu"
                                Clicked="Button_Menu_Clicked" />

                    </VerticalStackLayout>

                </Frame>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>