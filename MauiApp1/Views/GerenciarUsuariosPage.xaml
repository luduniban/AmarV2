<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.GerenciarUsuariosPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid>
        <Image Source="amarv_logo.png"
               Opacity="0.06"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <Grid Padding="20"
              RowDefinitions="Auto, *, Auto"
              RowSpacing="12">

            <Label Grid.Row="0"
                   Text="Gerenciar Usuários"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="12">

                    <Frame Padding="15"
                           BackgroundColor="White"
                           BorderColor="#DDDDDD">

                        <VerticalStackLayout Spacing="10">

                            <Label Text="Pessoa cadastrada:"
                                   FontAttributes="Bold"
                                   TextColor="Black" />

                            <Picker x:Name="pck_pessoa"
                                    Title="Selecione uma Pessoa"
                                    ItemDisplayBinding="{Binding Nome}"
                                    SelectedIndexChanged="Pck_Pessoa_SelectedIndexChanged"
                                    TextColor="Black"
                                    TitleColor="Gray"
                                    BackgroundColor="White" />

                            <Label Text="CPF:"
                                   TextColor="Black" />

                            <Label x:Name="lbl_cpf"
                                   Text="Selecione uma Pessoa"
                                   TextColor="Black" />

                            <Label Text="Data de nascimento:"
                                   TextColor="Black" />

                            <Label x:Name="lbl_data_nascimento"
                                   Text="Selecione uma Pessoa"
                                   TextColor="Black" />

                            <Label Text="Nome:"
                                   TextColor="Black" />

                            <Entry x:Name="entry_nome"
                                   Placeholder="Nome da Pessoa selecionada"
                                   IsReadOnly="True"
                                   TextColor="Black"
                                   PlaceholderColor="Gray"
                                   BackgroundColor="White" />

                            <Label Text="Login:"
                                   TextColor="Black" />

                            <Entry x:Name="entry_login"
                                   Placeholder="Login"
                                   TextColor="Black"
                                   PlaceholderColor="Gray"
                                   BackgroundColor="White" />

                            <Label Text="Senha:"
                                   TextColor="Black" />

                            <Entry x:Name="entry_senha"
                                   Placeholder="Senha"
                                   IsPassword="True"
                                   TextColor="Black"
                                   PlaceholderColor="Gray"
                                   BackgroundColor="White" />

                            <Label Text="Perfil:"
                                   TextColor="Black" />

                            <Picker x:Name="pck_perfil"
                                    Title="Selecione o perfil"
                                    TextColor="Black"
                                    TitleColor="Gray"
                                    BackgroundColor="White">
                                <Picker.Items>
                                    <x:String>Administrador</x:String>
                                    <x:String>Usuario</x:String>
                                </Picker.Items>
                            </Picker>

                            <HorizontalStackLayout x:Name="linha_ativo"
                                                   Spacing="10"
                                                   HeightRequest="50">

                                <CheckBox x:Name="chk_ativo"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          IsChecked="True" />

                                <Label Text="Usuário ativo"
                                       TextColor="Black"
                                       VerticalOptions="Center"
                                       FontAttributes="Bold" />
                            </HorizontalStackLayout>

                            <FlexLayout Wrap="Wrap"
                                        JustifyContent="Center"
                                        AlignItems="Center">

                                <Button Text="Salvar Novo"
                                        Margin="3"
                                        Clicked="Button_Salvar_Clicked" />

                                <Button Text="Atualizar"
                                        Margin="3"
                                        Clicked="Button_Atualizar_Clicked" />

                                <Button Text="Limpar"
                                        Margin="3"
                                        Clicked="Button_Limpar_Clicked" />
                            </FlexLayout>

                        </VerticalStackLayout>
                    </Frame>

                    <Label Text="Usuários cadastrados"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <CollectionView x:Name="collection_usuarios"
                                    SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="12"
                                       Margin="0,5"
                                       BackgroundColor="White"
                                       BorderColor="#DDDDDD">

                                    <VerticalStackLayout Spacing="8">

                                        <Label Text="{Binding Nome}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />

                                        <Label Text="{Binding Login, StringFormat='Login: {0}'}"
                                               TextColor="Black" />

                                        <Label Text="{Binding Perfil, StringFormat='Perfil: {0}'}"
                                               TextColor="Black" />

                                        <Label Text="{Binding Status, StringFormat='Status: {0}'}"
                                               TextColor="Black"
                                               FontAttributes="Bold" />

                                        <FlexLayout Wrap="Wrap"
                                                    JustifyContent="Center">

                                            <Button Text="Editar"
                                                    Margin="2"
                                                    FontSize="12"
                                                    Clicked="Button_Editar_Item_Clicked"
                                                    CommandParameter="{Binding .}" />

                                            <Button Text="Ativar"
                                                    Margin="2"
                                                    FontSize="12"
                                                    Clicked="Button_Ativar_Item_Clicked"
                                                    CommandParameter="{Binding .}" />

                                            <Button Text="Desativar"
                                                    Margin="2"
                                                    FontSize="12"
                                                    Clicked="Button_Desativar_Item_Clicked"
                                                    CommandParameter="{Binding .}" />

                                            <Button Text="Deletar"
                                                    Margin="2"
                                                    FontSize="12"
                                                    BackgroundColor="#B00020"
                                                    TextColor="White"
                                                    Clicked="Button_Deletar_Item_Clicked"
                                                    CommandParameter="{Binding .}" />
                                        </FlexLayout>

                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

            <Button Grid.Row="2"
                    Text="Voltar"
                    Clicked="Button_Menu_Clicked"
                    HorizontalOptions="Center" />

        </Grid>
    </Grid>
</ContentPage>
